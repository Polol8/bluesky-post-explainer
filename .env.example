# Required: OpenAI API key (used by the default provider)
OPENAI_API_KEY=sk-...

# Optional: Anthropic API key (enables the multi-provider comparison bonus feature)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (optional — runs as a Docker container, model is pulled automatically on `make up`)
# https://ollama.com — model must support tool use (e.g. llama3.2, qwen2.5, mistral-nemo)
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# Ports (optional — defaults shown)
BACKEND_PORT=8000
FRONTEND_PORT=3000
